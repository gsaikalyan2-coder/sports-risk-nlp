# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# .env is loaded automatically by scripts/run_crew.py and injected into
# containers by docker-compose.yml. Nothing here is baked into a Docker image --
# .env is in .dockerignore on purpose.

# Required for `python scripts/run_crew.py --live` (Phase 6 onward).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: experiment tracking from Phase 13.
WANDB_API_KEY=your_wandb_key_here

# Optional: attribution header sent to OpenRouter. Harmless to leave unset.
OPENROUTER_REFERER=https://github.com/your-handle/sports-risk-nlp

# Add source-specific data-acquisition keys below as needed, and record the
# source in config/data_sources_allowlist.yaml before using it (Phase 5 rule).
# YOUTUBE_API_KEY=your_key_here

# --- Category A5: public pseudonymous forum text (docs/ethics.md §3.5) -------
# Required for `python scripts/run_reddit.py`. Register a free "script" app at
# https://www.reddit.com/prefs/apps  ("script" type, redirect http://localhost:8080).
#
# REDDIT_USER_AGENT must identify the application AND carry a contact. Reddit's
# API rules require it, and P4 prohibits collection by a method the terms forbid,
# so run_reddit.py refuses to start on a generic agent rather than risking the
# violation. Use a real address you monitor -- it is also the route by which
# someone could ask to be removed (docs/ethics.md §7.1).
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=python:sports-risk-nlp:v0.1 (research; contact you@example.com)
